+	}
+	if strings.TrimSpace(baseStderr) != "" {
+		t.Fatalf("expected ignored base query stderr to be empty, got %q", baseStderr)
+	}
+
+	runErr = nil
+	includedStdout, includedStderr := captureProcessOutput(t, func() {
