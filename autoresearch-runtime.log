+			preparedIdx = &index.Index{
+				Root:    idx.Root,
+				Entries: clonedEntries,
+			}
+		}
+		preparedIdx.Entries[relPath] = data
+		return nil
+	})
+	if err != nil {
 		return nil, err
 	}
 
+	return preparedIdx, nil
+}
