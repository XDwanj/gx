+func TestSymbolsCommandIncludeOverridesIgnoreAndIgnoreRemovalRestoresVisibility(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	ensureCommandLanguages(t, "go")
+	t.Chdir(t.TempDir())
+
+	targetRoot := commandProject(t, map[string]string{
