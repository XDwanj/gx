func (state walkState) matches(relPath string, isDir bool) bool {
	if state.matcher == nil {
		return false
	}

	candidate := strings.ReplaceAll(relPath, "\\", "/")
	if isDir && !strings.HasSuffix(candidate, "/") {
		candidate += "/"
	}
	return state.matcher.MatchesPath(candidate)
}

