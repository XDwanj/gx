+func TestSymbolsJSONNoMatchesOutputsEmptyArray(t *testing.T) {
+	ensureInstalled(t, "rust")
+	root := tempProject(t, map[string]string{
+		"src/main.rs": "fn main() {}\n",
+	})
+
