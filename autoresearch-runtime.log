+
+func preparePathQueryIndex(idx *index.Index, query PathQuery) (*index.Index, []compiledGlob, []compiledGlob, *index.IgnoreMatcher, error) {
 	includeMatchers, err := compilePathGlobs(query.Include, idx.Root)
 	if err != nil {
