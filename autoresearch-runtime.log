func applyPathGlobs(filter *scopeFilter, includes []compiledGlob, excludes []compiledGlob) *scopeFilter {
	if filter == nil {
		return nil
	}
	if len(includes) == 0 && len(excludes) == 0 {
		return filter
	}

	filtered := &scopeFilter{
		isSingleFile: filter.isSingleFile,
		paths:        make(map[string]struct{}),
	}
	for path := range filter.paths {
		if len(includes) > 0 && !anyPathGlobMatches(includes, path) {
			continue
		}
		if anyPathGlobMatches(excludes, path) {
			continue
		}
		filtered.paths[path] = struct{}{}
	}
	if len(filtered.paths) != 1 {
		filtered.isSingleFile = false
	}
	return filtered
}

