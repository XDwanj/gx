+		if err := command.Flags().Set("name", "Hidden"); err != nil {
+			t.Fatalf("set name flag: %v", err)
+		}
+		if err := command.Flags().Set("include", "pkg/ignored.go"); err != nil {
+			t.Fatalf("set include flag: %v", err)
