+func withIncludedEntries(idx *index.Index, includes []compiledGlob) (*index.Index, error) {
+	if len(includes) == 0 {
+		return idx, nil
+	}
+
+	preparedIdx := idx
+	err := filepath.Walk(idx.Root, func(path string, info os.FileInfo, walkErr error) error {
+		if walkErr != nil {
+			return nil
+		}
+		if path == idx.Root {
+			return nil
+		}
+		if info.IsDir() {
+			if info.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+
