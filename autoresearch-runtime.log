+		return nil, nil, nil, nil, err
 	}
 	excludeMatchers, err := compilePathGlobs(query.Exclude, idx.Root)
 	if err != nil {
+		return nil, nil, nil, nil, err
+	}
+
+	preparedIdx, err := withIncludedEntries(idx, includeMatchers)
